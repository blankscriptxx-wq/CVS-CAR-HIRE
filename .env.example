# ─────────────────────────────────────────────────────────────
# CVS Car Hire — environment configuration
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://www.cvshire.co.uk

# ── Contact (public — safe to expose) ────────────────────────
# WhatsApp number in international format WITHOUT + or spaces (e.g. 447772233314)
NEXT_PUBLIC_CVS_WHATSAPP_NUMBER=447772233314
# Primary phone number (display + tel: links)
NEXT_PUBLIC_CVS_PHONE=01215723422
# Public enquiries email
NEXT_PUBLIC_CVS_EMAIL=

# ── Respond.io live chat (public widget id only) ─────────────
# Widget/script id for the embeddable web chat. This is NOT a secret.
NEXT_PUBLIC_RESPONDIO_WIDGET_ID=

# ── Respond.io / CRM server-side (SECRET — never NEXT_PUBLIC) ─
# Used by the /api/enquiry route to forward submitted forms into Respond.io / CRM.
RESPONDIO_API_TOKEN=
RESPONDIO_WEBHOOK_URL=

# ── Analytics (public ids, consent-gated) ────────────────────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=

# ── Social links (optional overrides of defaults in siteConfig) ─
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/cvshire

# Aniro.ai chat widget key (overrides the built-in default)
NEXT_PUBLIC_ANIRO_WIDGET_KEY=

# Google reviews (server-only key; owner to provide)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
