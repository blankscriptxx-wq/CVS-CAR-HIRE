# ─────────────────────────────────────────────────────────────
# CVS Car Hire — environment configuration
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://www.cvshire.co.uk

# ── Contact (public — safe to expose) ────────────────────────
# Primary phone number (display + tel: links)
NEXT_PUBLIC_CVS_PHONE=01215723422
# WhatsApp number in international format WITHOUT + or spaces (primary channel)
NEXT_PUBLIC_CVS_WHATSAPP_NUMBER=447772233314
# Public enquiries email
NEXT_PUBLIC_CVS_EMAIL=

# ── CRM / lead webhook (SECRET — never NEXT_PUBLIC) ──────────
# Optional. When set, the /api/enquiry route also forwards submitted forms to
# this webhook as a backstop. Primary lead delivery is the WhatsApp hand-off
# on the client, so these can be left blank.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=

# ── Analytics (public ids, consent-gated) ────────────────────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Google Search Console HTML-tag verification token (from GSC "HTML tag" method)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Social links (optional overrides of defaults in siteConfig) ─
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/cvshire


# Google Place ID — "CVS Self Drive and Wedding Car Hire".
# Powers keyless read/leave-a-review deep-links (client) and the Places API path.
# Defaults to the live Place ID in siteConfig; override here only if it changes.
NEXT_PUBLIC_GOOGLE_PLACE_ID=ChIJTz31FLu7cEgRv2o0D6e5URQ

# Google reviews via the Places API (optional — shows review cards on-site).
# Server-only key; GOOGLE_PLACE_ID should match the Place ID above.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=ChIJTz31FLu7cEgRv2o0D6e5URQ

# Keyless Google review cards via Featurable (featurable.com) — no API key needed
NEXT_PUBLIC_FEATURABLE_WIDGET_ID=
